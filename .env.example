# ------------------------------------------------------------------
# LocatorLab - variáveis de ambiente
# Copie este arquivo para ".env" e preencha os valores.
# Nunca faça commit do arquivo ".env".
# ------------------------------------------------------------------

# Conexão com pool (usada pela aplicação em tempo de execução).
# Neon: use a connection string "Pooled connection" (host com "-pooler").
# Supabase: use a "Transaction pooler" (porta 6543) e acrescente ?pgbouncer=true
DATABASE_URL="postgresql://USUARIO:SENHA@HOST-pooler.REGIAO.aws.neon.tech/BANCO?sslmode=require"

# Conexão direta (usada pelo Prisma para rodar as migrations).
# Neon: a mesma string, sem o "-pooler" no host.
# Supabase: use a "Session pooler" ou "Direct connection" (porta 5432).
DIRECT_URL="postgresql://USUARIO:SENHA@HOST.REGIAO.aws.neon.tech/BANCO?sslmode=require"

# Segredo usado pelo Auth.js (cookies de sessão) e pelos tokens da API.
# Gere com: npx auth secret   ou   openssl rand -base64 32
AUTH_SECRET=""

# Chave exigida no header "x-reset-key" do endpoint POST /api/v1/reset.
# Gere com: openssl rand -hex 24
RESET_KEY=""
